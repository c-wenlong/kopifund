{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kopifund",
  "version": "0.1.0",
  "identifier": "com.kopifund.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kopifund",
        "url": "index.html",
        "width": 1280,
        "height": 840,
        "minWidth": 400,
        "minHeight": 500,
        "create": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Finance",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
